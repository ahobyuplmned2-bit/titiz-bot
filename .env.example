# متغيرات بيئية لبوت Titiz

# بيانات WhatsApp
ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=your_verify_token_here
OWNER_NUMBER=your_admin_phone_number

# بيانات GitHub (اختياري)
GITHUB_TOKEN=your_github_token_here

# إعدادات التطبيق
PORT=10000
ENVIRONMENT=development

# فهم الرسائل الصوتية والرد الذكي
# ضع مفتاح مزود متوافق مع OpenAI هنا في Render.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
VOICE_TRANSCRIPTION_MODEL=whisper-1
SMART_AI_MODEL=gpt-5-mini

# قاعدة البيانات (SQLite للتطوير)
DATABASE_URL=sqlite:///titiz_bot.db

# للإنتاج استخدم PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost/titiz_bot
